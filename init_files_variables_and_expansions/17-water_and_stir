#!/bin/bash

decode() {
    local value="$1"
    local base="$2"
    local base_len=${#base}
    local result=0

    for (( i=0; i<${#value}; i++ )); do
        char="${value:$i:1}"
        pos="${base%%$char*}"
        digit=${#pos}
        result=$(( result * base_len + digit ))
    done

    echo $result
}

encode() {
    local num="$1"
    local base="$2"
    local base_len=${#base}
    local result=""

    if (( num == 0 )); then
        echo "${base:0:1}"
        return
    fi

    while (( num > 0 )); do
        remainder=$(( num % base_len ))
        result="${base:$remainder:1}$result"
        num=$(( num / base_len ))
    done

    echo "$result"
}

num1=$(decode "$WATER" "water")
num2=$(decode "$STIR" "stir.")
sum=$(( num1 + num2 ))
encode "$sum" "bestchol"
